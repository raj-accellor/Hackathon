# Copy to .env and fill in. Never commit .env. Every value here is a placeholder.

# ---- Application
APP_ENV=local                      # local | staging | production
DATA_MODE=demo                     # demo = local mock MCP servers with synthetic data; live = the URLs below
LOG_LEVEL=INFO
DEFAULT_MARKET_TIMEZONE=Asia/Kolkata
API_AUTH_TOKEN=                    # set a long random value to require "Authorization: Bearer <token>" on /api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SCHEDULER_ENABLED=true             # set false on the API when a separate worker runs the schedule
AUTO_CREATE_SCHEMA=true            # set false in deployment and run `alembic upgrade head`
AUTO_INITIAL_REFRESH=true

# ---- Storage
DATABASE_URL=sqlite+aiosqlite:///./var/app.db
# DATABASE_URL=postgresql+asyncpg://markets:CHANGE_ME@postgres:5432/markets
REDIS_URL=                         # e.g. redis://redis:6379/0 ; empty = in-process cache and locks (single process only)

# ---- Market data: NSE MCP (primary) and broker MCP (fallback). Used when DATA_MODE=live.
NSE_BHAVCOPY_MCP_URL=https://mcp.nseindia.in/bhavcopy/cm/mcp
NSE_CM_MARKET_MCP_URL=https://mcp.nseindia.in/cmmkt/mcp
BROKER_MCP_URL=https://mcp.kite.trade/mcp
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_MAX_CONCURRENCY=4
MCP_MAX_RETRIES=2
NSE_MCP_MIN_INTERVAL_SECONDS=0.2
BROKER_MCP_MIN_INTERVAL_SECONDS=0.35
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_SECONDS=60

# ---- Kite Connect v3 REST (optional second broker path; needs a Kite developer app)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=                 # expires daily at 06:00 IST; can also be set through POST /sources/kite-connect/session

# ---- LLM: GLM through Hugging Face
LLM_ENABLED=false
HF_TOKEN=
HF_MODEL_ID=                       # exact id as listed by the route, e.g. zai-org/GLM-5.3-Flash; verified on the Data status page
HF_ENDPOINT_URL=                   # optional; leave blank to use the Hugging Face router. With or without a trailing /v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=2000
LLM_DAILY_BUDGET=200               # research/concall model calls per UTC day
LLM_DAILY_TOKEN_BUDGET=2000000

# ---- Web research
WEB_SEARCH_PROVIDER=ddgs           # ddgs (no key needed) | brave | none. Always off in demo mode.
WEB_SEARCH_API_KEY=                # only for brave
WEB_SEARCH_MAX_RESULTS=8

# ---- Schedules (cron, in DEFAULT_MARKET_TIMEZONE)
THEME_REFRESH_CRON=30 6 1 * *      # monthly
RRG_REFRESH_CRON=0 */12 * * *      # every 12 hours
PRICE_REFRESH_CRON=30 19 * * 1-5
INSTRUMENT_REFRESH_CRON=0 7 * * 1-5
ALERTS_CRON=*/15 * * * *

# ---- Universe, cache TTLs (seconds), rate limits
BENCHMARK_SYMBOL=NIFTY 50
HISTORY_YEARS=3
CACHE_TTL_QUOTE=60
CACHE_TTL_HISTORY=21600
CACHE_TTL_INSTRUMENT=86400
RATE_LIMIT_RESEARCH_PER_MINUTE=6
RATE_LIMIT_REFRESH_PER_MINUTE=3
RATE_LIMIT_DEFAULT_PER_MINUTE=300
MAX_REQUEST_BYTES=5000000
