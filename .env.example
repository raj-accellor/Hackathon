# Copy to .env and fill in. Never commit .env. Every value here is a placeholder.
#
# Keep comments on their own lines. Docker Compose reads `KEY=value   # note` as the value
# "value   # note"; the app strips such notes, but other tools may not.

# ---------------------------------------------------------------- Application
# local | staging | production
APP_ENV=local
# demo = local mock MCP servers with synthetic data; live = the MCP URLs below
DATA_MODE=demo
LOG_LEVEL=INFO
DEFAULT_MARKET_TIMEZONE=Asia/Kolkata
# Set a long random value to require "Authorization: Bearer <token>" on /api/v1. Blank = off.
API_AUTH_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set false on the API when a separate worker process runs the schedule.
SCHEDULER_ENABLED=true
# Ingest and score everything automatically the first time the database is empty.
AUTO_INITIAL_REFRESH=true

# ---------------------------------------------------------------- Database (PostgreSQL via psycopg 3)
# scripts/dev.sh starts this database with Docker Compose when it is local and not running.
# postgres://, postgresql:// and postgresql+asyncpg:// URLs are rewritten to postgresql+psycopg://.
# For a managed database add ?sslmode=require.
DATABASE_URL=postgresql+psycopg://markets:markets@localhost:5432/markets
# Password of the local Compose database (must match DATABASE_URL).
POSTGRES_PASSWORD=markets
# The schema comes from Alembic migrations (scripts/dev.sh runs them). Leave false.
AUTO_CREATE_SCHEMA=false

# ---------------------------------------------------------------- Cache (optional)
# Blank = in-process cache and locks (fine for one API process). With a separate worker use Redis,
# e.g. redis://localhost:6379/0 locally or redis://redis:6379/0 inside Compose.
REDIS_URL=

# ---------------------------------------------------------------- Market data over MCP (live mode)
# NSE MCP is the primary source; Kite MCP fills gaps and is used to cross-check NSE values.
NSE_BHAVCOPY_MCP_URL=https://mcp.nseindia.in/bhavcopy/cm/mcp
NSE_CM_MARKET_MCP_URL=https://mcp.nseindia.in/cmmkt/mcp
BROKER_MCP_URL=https://mcp.kite.trade/mcp
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_MAX_CONCURRENCY=4
MCP_MAX_RETRIES=2
NSE_MCP_MIN_INTERVAL_SECONDS=0.2
BROKER_MCP_MIN_INTERVAL_SECONDS=0.35
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_SECONDS=60

# ---------------------------------------------------------------- LLM: GLM through Hugging Face
LLM_ENABLED=false
HF_TOKEN=
# Exact id as the Hugging Face router lists it, e.g. zai-org/GLM-5.3-Flash
HF_MODEL_ID=
# Optional dedicated endpoint; blank = Hugging Face router. With or without a trailing /v1.
HF_ENDPOINT_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=2000
# Model calls per UTC day, and tokens per UTC day
LLM_DAILY_BUDGET=200
LLM_DAILY_TOKEN_BUDGET=2000000

# ---------------------------------------------------------------- Web research
# ddgs (no key needed) | brave | none. Always off in demo mode (demo symbols are fictional).
WEB_SEARCH_PROVIDER=ddgs
# Only needed for brave
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=8

# ---------------------------------------------------------------- Schedules (cron, DEFAULT_MARKET_TIMEZONE)
# Themes monthly, sector rotation every 12 hours
THEME_REFRESH_CRON=30 6 1 * *
RRG_REFRESH_CRON=0 */12 * * *
PRICE_REFRESH_CRON=30 19 * * 1-5
INSTRUMENT_REFRESH_CRON=0 7 * * 1-5
ALERTS_CRON=*/15 * * * *

# ---------------------------------------------------------------- Universe, cache TTLs (seconds), limits
BENCHMARK_SYMBOL=NIFTY 50
HISTORY_YEARS=3
CACHE_TTL_QUOTE=60
CACHE_TTL_HISTORY=21600
CACHE_TTL_INSTRUMENT=86400
RATE_LIMIT_RESEARCH_PER_MINUTE=6
RATE_LIMIT_REFRESH_PER_MINUTE=3
RATE_LIMIT_DEFAULT_PER_MINUTE=300
MAX_REQUEST_BYTES=5000000
